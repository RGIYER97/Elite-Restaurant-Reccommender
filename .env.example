# Required: enable "Places API (New)" for this key.
GOOGLE_PLACES_API_KEY=replace_with_your_google_places_key

# Optional: use a separately restricted key for browser-loaded map tiles.
# If omitted, GOOGLE_PLACES_API_KEY is used for both services.
GOOGLE_MAP_TILES_API_KEY=

# Map Tiles API requires a two-letter CLDR region code.
MAP_REGION=US
MAP_LANGUAGE=en-US

# 0 means follow every nextPageToken returned by Google.
PLACES_API_MAX_PAGES=0
